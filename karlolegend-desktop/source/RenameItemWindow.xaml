<Window x:Class="KarloDiskShell.RenameItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        Width="430"
        Height="155"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101010"
        Foreground="#F5F5F5"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Name" Foreground="#FFD800" FontWeight="SemiBold"/>

        <TextBox x:Name="NameTextBox"
                 Grid.Row="1"
                 Margin="0,7,0,12"
                 Padding="8,6"
                 Background="#181818"
                 Foreground="#F5F5F5"
                 BorderBrush="#444444"
                 KeyDown="NameTextBox_KeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="86" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Rename" Width="86" IsDefault="True" Click="RenameButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
