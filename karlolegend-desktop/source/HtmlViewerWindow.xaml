<Window x:Class="KarloDiskShell.HtmlViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="KARLOLEGEND — HTML"
        Width="1180"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        Background="#101010"
        Foreground="#F5F5F5"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#171717"
                BorderBrush="#2B2B2B"
                BorderThickness="0,0,0,1"
                Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BackButton" Content="←" Click="BackButton_Click" ToolTip="Back"/>
                    <Button x:Name="ForwardButton" Content="→" Click="ForwardButton_Click" ToolTip="Forward"/>
                    <Button Content="↻" Click="ReloadButton_Click" ToolTip="Reload"/>
                    <Button Content="External" Click="OpenExternalButton_Click" ToolTip="Open this HTML file in the Windows default browser"/>
                </StackPanel>

                <TextBlock x:Name="PathText"
                           Foreground="#FFD800"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="1"/>

        <Border Grid.Row="2"
                Background="#171717"
                BorderBrush="#2B2B2B"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <DockPanel>
                <TextBlock Text="KARLOLEGEND HTML"
                           Foreground="#FFD800"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Right"
                           Foreground="#8D8D8D"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
