<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>KARLOLEGEND</AssemblyName>
    <RootNamespace>KarloDiskShell</RootNamespace>
    <Version>0.4.0</Version>

    <!-- Final deployment goal: one Windows x64 EXE at K:\KARLOLEGEND.exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- WebView2 ships IntelliSense/reference XML files beside the published app.
       They are documentation, not runtime dependencies. Remove them after publish
       so the K: deployment contract remains exactly one visible executable. -->
  <Target Name="RemovePublishedDocumentationFiles" AfterTargets="Publish">
    <ItemGroup>
      <PublishedDocumentationFiles Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(PublishedDocumentationFiles)" />
  </Target>

</Project>
